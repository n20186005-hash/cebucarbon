---
import { getContent, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang).transport;
const labels =
  lang === 'fil'
    ? { duration: 'Oras', cost: 'Gastos', steps: 'Paano sumakay', tip: 'Paalala' }
    : { duration: 'Oras', cost: 'Gasto', steps: 'Unsaon pagsakay', tip: 'Paalala' };
---

<section id="getting-here" class="section-pad border-b-2 border-[var(--ink)]">
  <div class="shell">
    <div class="grid items-end gap-8 lg:grid-cols-[.85fr_1.15fr]">
      <div>
        <p class="kicker">{t.kicker}</p>
        <h2 class="display mt-5 text-4xl leading-[.95] sm:text-5xl">{t.title}</h2>
        <h3 class="mt-4 text-xl font-black uppercase tracking-wide text-[var(--tomato)]">{t.subtitle}</h3>
      </div>
      <p class="text-sm leading-6 text-[var(--muted)]">{t.intro}</p>
    </div>

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {
        t.modes.map((mode) => (
          <article class="border-2 border-[var(--ink)] bg-[var(--paper)] p-6 shadow-[6px_6px_0_var(--ink)]">
            <div class="flex items-start gap-4">
              <span class="display text-3xl leading-none text-[var(--market-orange)]">{mode.tag}</span>
              <div>
                <h3 class="text-lg font-black uppercase leading-tight">{mode.title}</h3>
                <p class="mt-2 text-xs font-black uppercase tracking-[.14em] text-[var(--tomato)]">{mode.bestFor}</p>
              </div>
            </div>

            <dl class="mt-5 grid gap-px border-2 border-[var(--ink)] bg-[var(--ink)] sm:grid-cols-2">
              <div class="bg-[var(--paper-deep)] p-4">
                <dt class="text-[11px] font-black uppercase tracking-[.14em] text-[var(--tomato)]">{labels.duration}</dt>
                <dd class="mt-1 text-sm font-bold leading-5">{mode.duration}</dd>
              </div>
              <div class="bg-[var(--paper-deep)] p-4">
                <dt class="text-[11px] font-black uppercase tracking-[.14em] text-[var(--tomato)]">{labels.cost}</dt>
                <dd class="mt-1 text-sm font-bold leading-5">{mode.cost}</dd>
              </div>
            </dl>

            <p class="mt-5 text-[11px] font-black uppercase tracking-[.14em] text-[var(--tomato)]">{labels.steps}</p>
            <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm leading-6 text-[var(--muted)]">
              {mode.steps.map((step) => (
                <li>{step}</li>
              ))}
            </ol>

            <p class="mt-5 border-l-[4px] border-[var(--market-orange)] pl-4 text-sm leading-6 text-[var(--ink-soft)]">
              <strong class="uppercase tracking-[.12em] text-[var(--ink)]">{labels.tip}:</strong> {mode.tip}
            </p>
          </article>
        ))
      }
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      <div class="border-2 border-[var(--ink)] bg-[var(--paper-deep)] p-6">
        <h3 class="text-lg font-black uppercase">{t.walkTitle}</h3>
        <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{t.walkNote}</p>
      </div>
      <div class="border-2 border-[var(--ink)] bg-[var(--market-orange)] p-6">
        <h3 class="text-lg font-black uppercase">{t.accessTitle}</h3>
        <p class="mt-3 text-sm leading-6 text-[var(--ink)]/85">{t.accessNote}</p>
      </div>
    </div>
  </div>
</section>
