---
import { getContent, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang).services;
---

<section id="services" class="section-pad border-b-2 border-[var(--ink)] bg-[var(--paper-deep)]">
  <div class="shell">
    <div class="grid items-end gap-8 lg:grid-cols-[.85fr_1.15fr]">
      <div>
        <p class="kicker">{t.kicker}</p>
        <h2 class="display mt-5 text-4xl leading-[.95] sm:text-5xl">{t.title}</h2>
        <h3 class="mt-4 text-xl font-black uppercase tracking-wide text-[var(--tomato)]">{t.subtitle}</h3>
      </div>
      <p class="text-sm leading-6 text-[var(--muted)]">{t.intro}</p>
    </div>

    <div class="mt-10 grid gap-px border-2 border-[var(--ink)] bg-[var(--ink)] sm:grid-cols-2 lg:grid-cols-3">
      {
        t.items.map((item) => (
          <article class="service-card bg-[var(--paper)] p-6">
            <span class="block text-2xl leading-none text-[var(--market-orange)]" aria-hidden="true">{item.icon}</span>
            <h3 class="mt-4 text-base font-black uppercase leading-tight">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{item.body}</p>
          </article>
        ))
      }
    </div>

    <p class="mt-8 max-w-3xl border-2 border-dashed border-[var(--ink)] bg-[var(--paper)] p-5 text-xs leading-5 text-[var(--muted)]">
      {t.policyNote}
    </p>
  </div>
</section>
