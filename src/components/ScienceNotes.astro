---
import { getContent, type Lang } from '../data/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getContent(lang).science;
const noteLabel = lang === 'fil' ? 'Paano ito gumagana' : 'Giunsa kini paglihok';
---

<section id="science" class="section-pad border-b-2 border-[var(--ink)] bg-[var(--paper-deep)]">
  <div class="shell">
    <div class="grid items-end gap-8 lg:grid-cols-[.85fr_1.15fr]">
      <div>
        <p class="kicker">{t.kicker}</p>
        <h2 class="display mt-5 text-4xl leading-[.95] sm:text-5xl">{t.title}</h2>
        <h3 class="mt-4 text-xl font-black uppercase tracking-wide text-[var(--tomato)]">{t.subtitle}</h3>
      </div>
      <p class="text-sm leading-6 text-[var(--muted)]">{t.intro}</p>
    </div>

    <div class="mt-10 grid gap-px border-2 border-[var(--ink)] bg-[var(--ink)] md:grid-cols-2 lg:grid-cols-3">
      {
        t.items.map((item) => (
          <article class="bg-[var(--paper)] p-6">
            <p class="text-[11px] font-black uppercase tracking-[.16em] text-[var(--tomato)]">{noteLabel}</p>
            <h3 class="mt-3 text-base font-black uppercase leading-tight">{item.title}</h3>
            <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{item.body}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-8 border-2 border-[var(--ink)] bg-[var(--market-orange)] p-6 sm:p-8">
      <h3 class="text-lg font-black uppercase">{t.pledgeTitle}</h3>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          t.pledges.map((pledge) => (
            <li class="flex gap-3 text-sm leading-6 text-[var(--ink)]/85">
              <span aria-hidden="true">▪</span>
              <span>{pledge}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-8 max-w-3xl text-xs leading-5 text-[var(--muted)]">{t.editorialNote}</p>
  </div>
</section>
