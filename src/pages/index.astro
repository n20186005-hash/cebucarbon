---
import '../styles/global.css';

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL('/images/carbon-market-hero.jpg', Astro.site).href : undefined;
const pageTitle = 'Pamilihang Carbon · Ang buhing merkado sa kasingkasing sa Sugbo';
const pageDescription = 'Giya sa pagbisita sa Carbon Market sa Cebu City: libre nga pagsulod, pagkaon, transportasyon, parking, duol nga heritage spots, mapa ug praktikal nga tips.';

const highlights = [
  { value: 'Libre', label: 'pagsulod sa merkado' },
  { value: '1–3 ka oras', label: 'maayong gidugayon sa suroy' },
  { value: 'Sayong buntag', label: 'para sa preskong abot' },
  { value: 'Downtown', label: 'duol sa karaang Sugbo' },
];

const nearby = [
  { name: 'Magellan’s Cross', note: 'Usa ka mubo nga lakaw paingon sa Plaza Sugbo; sayon iusa sa usa ka heritage walk.' },
  { name: 'Basilica Minore del Santo Niño', note: 'Ang pinakailadong religious landmark sa sentro sa Sugbo, tupad ra sa Magellan’s Cross.' },
  { name: 'Fort San Pedro', note: 'Padayon gikan sa Plaza Independencia para sa usa ka hapsay nga ruta gikan merkado ngadto sa baybayon.' },
  { name: 'Casa Gorordo Museum', note: 'Para sa mas lawom nga tan-aw sa kinabuhi ug arkitektura sa karaang Cebu.' },
];

const faqs = [
  {
    q: 'Naay entrance fee sa Carbon Market?',
    a: 'Wala. Libre ang pagsulod sa merkado. Bayran ra nimo ang imong paliton, pagkaon, transportasyon ug ubang personal nga gasto.'
  },
  {
    q: 'Unsa ang pinakamaayong oras sa pag-adto?',
    a: 'Sayong buntag ang nindot para sa preskong abot ug mas bugnaw nga lakaw. Kung gusto ka sa mas buhing food-and-city atmosphere, maayo usab ang ulahing hapon. Magkalahi ang oras sa tagsa-tagsa ka tindahan.'
  },
  {
    q: 'Pila ka oras ang angay igahin?',
    a: 'Kasagaran igo ang 1–3 ka oras para sa merkado, pagkaon ug litrato. Dugangi ang oras kung iapil nimo ang Basilica, Magellan’s Cross ug Fort San Pedro.'
  },
  {
    q: 'Unsaon pag-adto kung gikan sa sentro sa Cebu?',
    a: 'Taxi o Grab ang pinakasayon. Sa jeepney, pangitaa ang signboard nga paingon sa Carbon ug pangutan-a ang drayber kay mahimong mausab ang ruta tungod sa traffic ug redevelopment.'
  },
  {
    q: 'Naay parking?',
    a: 'Adunay parking options sulod sa redeveloped Carbon area ug duol sa Pusô Village. Ang access ug capacity mahimong mausab, busa sundi ang on-site signs ug marshals sa adlaw sa imong pagbisita.'
  },
  {
    q: 'Okay ba dal-on ang bata o senior?',
    a: 'Pwede, apan hinumdomi nga aktibong merkado kini: mahimong huot, basa ang pipila ka agianan ug daghan ang delivery traffic. Mas komportable ang closed shoes ug mas hinay nga pacing.'
  },
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  name: 'Carbon Market',
  alternateName: 'Pamilihang Carbon',
  description: pageDescription,
  address: {
    '@type': 'PostalAddress',
    streetAddress: '59 M. C. Briones St',
    addressLocality: 'Cebu City',
    postalCode: '6000',
    addressRegion: 'Cebu',
    addressCountry: 'PH',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 10.2914389,
    longitude: 123.899131,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '00:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '00:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '00:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '05:00', closes: '18:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '00:30', closes: '10:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '00:00', closes: '15:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '00:00', closes: '19:00' },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: 3.3,
    bestRating: 5,
  },
  isAccessibleForFree: true,
  priceRange: 'Libre ang pagsulod',
  ...(canonical ? { url: canonical } : {}),
  ...(socialImage ? { image: socialImage } : {}),
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<!doctype html>
<html lang="ceb">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#15271f" />
    <meta name="color-scheme" content="light" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content="ceb_PH" />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(attractionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:bg-[var(--market-orange)] focus:px-4 focus:py-3 focus:font-bold">Laktawi ngadto sa sulod</a>

    <header class="sticky top-0 z-50 border-b-2 border-[var(--ink)] bg-[color:rgba(243,234,213,.94)] backdrop-blur-md">
      <div class="shell flex min-h-18 items-center justify-between gap-6 py-3">
        <a href="#top" aria-label="Pamilihang Carbon — balik sa ibabaw" class="shrink-0">
          <img src="/logo.svg" width="242" height="64" alt="Pamilihang Carbon" class="h-12 w-auto sm:h-13" />
        </a>
        <nav aria-label="Pangunang nabigasyon" class="hidden items-center gap-6 text-[13px] font-extrabold uppercase tracking-[.13em] lg:flex">
          <a class="nav-link" href="#experience">Kasinaran</a>
          <a class="nav-link" href="#plan">Pagplano</a>
          <a class="nav-link" href="#food">Pagkaon</a>
          <a class="nav-link" href="#nearby">Duol</a>
          <a class="nav-link" href="#faq">FAQ</a>
        </nav>
        <a href="#mapa" class="border-2 border-[var(--ink)] bg-[var(--ink)] px-4 py-2.5 text-xs font-black uppercase tracking-[.14em] text-[var(--paper)] shadow-[4px_4px_0_var(--market-orange)] transition hover:-translate-y-0.5">Mapa</a>
      </div>
    </header>

    <main id="main">
      <section id="top" class="market-grid relative overflow-hidden border-b-2 border-[var(--ink)]">
        <div class="shell grid min-h-[calc(100vh-76px)] items-stretch lg:grid-cols-[.92fr_1.08fr]">
          <div class="relative z-10 flex flex-col justify-center py-14 lg:pr-12 lg:py-20">
            <p class="kicker">Cebu City · Sugbo</p>
            <h1 class="display mt-6 max-w-[8ch] text-[clamp(4.7rem,11vw,9.8rem)] leading-[.78]">Carbon Market</h1>
            <div class="mt-7 max-w-xl border-l-[5px] border-[var(--market-orange)] pl-5 text-lg leading-8 text-[var(--ink-soft)] sm:text-xl">
              Dili kini lugar nga tan-awon lang. Kini usa ka <strong>buhing merkado</strong> — preskong abot, tingog sa tindero, puso ug sud-an, ug adlaw-adlaw nga kinabuhi sa karaang Sugbo.
            </div>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#plan" class="inline-flex items-center gap-3 border-2 border-[var(--ink)] bg-[var(--market-orange)] px-5 py-3.5 text-sm font-black uppercase tracking-[.12em] shadow-[5px_5px_0_var(--ink)] transition hover:-translate-y-1">Planoha ang suroy <span aria-hidden="true">↘</span></a>
              <a href="#experience" class="inline-flex items-center gap-3 border-2 border-[var(--ink)] bg-[var(--paper)] px-5 py-3.5 text-sm font-black uppercase tracking-[.12em] transition hover:bg-white/50">Ilhon ang merkado</a>
            </div>
            <p class="mt-8 max-w-lg text-sm leading-6 text-[var(--muted)]">Padayon ang redevelopment sa Carbon; mahimong mausab ang pipila ka entrada, pwesto ug traffic flow. Sundon ang on-site signage sa adlaw sa pagbisita.</p>
          </div>

          <div class="relative min-h-[550px] border-t-2 border-[var(--ink)] lg:border-l-2 lg:border-t-0">
            <img src="/images/carbon-market-hero.jpg" alt="Gabhion nga talan-awon sa Carbon Market nga puno sa mga bisita ug suga sa merkado" width="1400" height="934" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-[rgba(21,39,31,.72)] via-transparent to-[rgba(21,39,31,.15)]"></div>
            <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4">
              <div class="max-w-sm bg-[var(--paper)] p-4 shadow-[5px_5px_0_var(--market-orange)]">
                <p class="text-xs font-black uppercase tracking-[.16em] text-[var(--tomato)]">Kasingkasing sa downtown</p>
                <p class="mt-1 font-bold leading-6">Merkado, pagkaon ug heritage landmarks sa usa ra ka lakaw.</p>
              </div>
              <div class="hidden size-20 rotate-6 items-center justify-center border-2 border-[var(--paper)] bg-[var(--ink)] text-center text-[10px] font-black uppercase tracking-[.1em] text-[var(--paper)] sm:flex">Suroy<br/>Sugbo</div>
            </div>
          </div>
        </div>

        <div class="border-t-2 border-[var(--ink)] bg-[var(--ink)] text-[var(--paper)]">
          <div class="shell grid grid-cols-2 lg:grid-cols-4">
            {highlights.map((item, index) => (
              <div class:list={["px-4 py-5 sm:px-6", index > 0 && "border-l border-white/20", index === 2 && "border-l-0 lg:border-l", index >= 2 && "border-t border-white/20 lg:border-t-0"]}>
                <div class="display text-2xl text-[var(--market-orange)] sm:text-3xl">{item.value}</div>
                <div class="mt-1 text-xs font-semibold uppercase tracking-[.1em] text-white/68">{item.label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="experience" class="section-pad overflow-hidden">
        <div class="shell">
          <div class="grid items-end gap-8 lg:grid-cols-[.8fr_1.2fr]">
            <div>
              <p class="kicker">Kasinaran sa Carbon</p>
              <h2 class="display mt-5 text-5xl leading-[.92] sm:text-7xl">Merkado una. Tourist spot ikaduha.</h2>
            </div>
            <p class="max-w-2xl text-lg leading-8 text-[var(--muted)] lg:justify-self-end">Ang Carbon mao ang usa sa labing iladong public markets sa Cebu. Ang kalami niini naa sa tinuod nga lihok sa lungsod: prutas ug utan, isda, karne, dry goods, handicrafts ug pagkaon — dili curated display, kundili adlaw-adlaw nga palit ug baligya.</p>
          </div>

          <div class="mt-14 grid auto-rows-[220px] gap-5 md:grid-cols-12 md:auto-rows-[240px]">
            <figure class="photo-frame relative md:col-span-7 md:row-span-2">
              <img src="/images/carbon-market-aerial.jpg" alt="Talan-awon sa Carbon Market area sa gabii gikan sa taas" loading="lazy" width="1024" height="767" />
              <figcaption class="absolute bottom-3 left-3 bg-[var(--paper)] px-3 py-2 text-xs font-black uppercase tracking-[.12em]">Buhing downtown</figcaption>
            </figure>
            <div class="price-tag flex flex-col justify-between p-6 md:col-span-5">
              <span class="display text-5xl text-[var(--market-orange)]">01</span>
              <div>
                <h3 class="text-xl font-black uppercase tracking-wide">Preskong abot</h3>
                <p class="mt-2 leading-6 text-[var(--muted)]">Sayong buntag, mas klaro ang rhythm sa produce, seafood ug wholesale movement.</p>
              </div>
            </div>
            <figure class="photo-frame relative md:col-span-5">
              <img src="/images/carbon-market-produce-night.jpg" alt="Mga tindahan sa Carbon Market nga adunay prutas, utan ug gabii nga suga" loading="lazy" width="1200" height="800" />
              <figcaption class="absolute bottom-3 left-3 bg-[var(--market-orange)] px-3 py-2 text-xs font-black uppercase tracking-[.12em]">Kolor sa merkado</figcaption>
            </figure>
          </div>

          <div class="mt-5 grid gap-5 md:grid-cols-3">
            <article class="border-2 border-[var(--ink)] p-6">
              <span class="text-3xl" aria-hidden="true">◈</span>
              <h3 class="mt-5 text-xl font-black uppercase">Palit sama sa lokal</h3>
              <p class="mt-3 leading-7 text-[var(--muted)]">Pagdala ug gamay nga cash ug reusable bag. Pangutana sa presyo una ug ayaw kahadlok motan-aw sa lain-laing stall.</p>
            </article>
            <article class="border-2 border-[var(--ink)] bg-[var(--leaf)] p-6 text-white">
              <span class="text-3xl" aria-hidden="true">◇</span>
              <h3 class="mt-5 text-xl font-black uppercase">Sul-ob ug closed shoes</h3>
              <p class="mt-3 leading-7 text-white/80">Aktibong public market kini. Ang pipila ka agianan mahimong basa o puno sa delivery carts, labi na sa busy nga oras.</p>
            </article>
            <article class="border-2 border-[var(--ink)] bg-[var(--market-orange)] p-6">
              <span class="text-3xl" aria-hidden="true">✦</span>
              <h3 class="mt-5 text-xl font-black uppercase">Ipares sa heritage walk</h3>
              <p class="mt-3 leading-7 text-[var(--ink-soft)]">Human sa merkado, dali ra ipadayon paingon sa Magellan’s Cross, Basilica ug Fort San Pedro.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="plan" class="border-y-2 border-[var(--ink)] bg-[var(--ink)] text-[var(--paper)]">
        <div class="shell section-pad">
          <div class="grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
            <div class="lg:sticky lg:top-28 lg:self-start">
              <p class="kicker !text-[var(--market-orange)]">Praktikal nga giya</p>
              <h2 class="display mt-5 text-5xl leading-[.9] sm:text-7xl">Sa dili pa ka mosulod</h2>
              <p class="mt-6 max-w-md leading-7 text-white/65">Ang Carbon usa ka working market. Ang pinakamaayong plano flexible: pilia ang oras, kahibalo sa imong transport, ug ibilin ang sobra nga schedule.</p>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <article class="border border-white/25 bg-white/[.05] p-6 sm:col-span-2">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-xs font-black uppercase tracking-[.18em] text-[var(--market-orange)]">Gasto / Bayranan</p>
                    <h3 class="display mt-2 text-4xl">Walay entrance fee</h3>
                  </div>
                  <span class="display text-5xl text-white/20">₱0</span>
                </div>
                <p class="mt-4 max-w-2xl leading-7 text-white/68">Libre ang pagsulod sa public market. Mag-andam lang ug budget para sa imong paliton, pagkaon, pamasahe ug parking kung magdala kag sakyanan.</p>
              </article>

              <article class="border border-white/25 bg-white/[.05] p-6">
                <p class="text-xs font-black uppercase tracking-[.18em] text-[var(--market-orange)]">Pinakamaayong oras</p>
                <h3 class="mt-3 text-2xl font-black">Sayong buntag</h3>
                <p class="mt-3 leading-7 text-white/65">Para sa preskong produce, mas bugnaw nga temperatura ug pinakatinuod nga wholesale-market rhythm.</p>
                <div class="mt-5 border-t border-white/20 pt-5">
                  <h3 class="text-lg font-black">Ulahing hapon</h3>
                  <p class="mt-2 text-sm leading-6 text-white/65">Para sa food stops, city lights ug mas relaxed nga paglakaw human sa init sa udto.</p>
                </div>
              </article>

              <article class="border border-white/25 bg-white/[.05] p-6">
                <p class="text-xs font-black uppercase tracking-[.18em] text-[var(--market-orange)]">Gidugayon</p>
                <h3 class="display mt-3 text-5xl">1–3 ka oras</h3>
                <p class="mt-3 leading-7 text-white/65">Igo para motuyok, mokaon ug motan-aw sa market life. Himoa nga tunga sa adlaw kung iapil ang heritage loop.</p>
              </article>

              <article class="border border-white/25 bg-white/[.05] p-6 sm:col-span-2">
                <p class="text-xs font-black uppercase tracking-[.18em] text-[var(--market-orange)]">Parking</p>
                <div class="mt-3 grid gap-5 md:grid-cols-[.7fr_1.3fr]">
                  <h3 class="display text-4xl">Sulod sa Carbon district</h3>
                  <div>
                    <p class="leading-7 text-white/68">Adunay parking sa redeveloped Carbon area ug duol sa Pusô Village. Tungod sa ongoing redevelopment, mahimong mausab ang entry points ug available slots.</p>
                    <p class="mt-3 text-sm font-bold text-[var(--market-orange)]">Tip: Sunda ang official parking signs ug marshals; ayaw pagsalig sa daang online route screenshots.</p>
                  </div>
                </div>
              </article>

              <article class="border border-white/25 bg-white/[.05] p-6 sm:col-span-2">
                <p class="text-xs font-black uppercase tracking-[.18em] text-[var(--market-orange)]">Oras sa operasyon</p>
                <h3 class="mt-3 text-2xl font-black">Lahi-lahi depende sa zone ug stall</h3>
                <p class="mt-3 leading-7 text-white/65">Public listings kasagarang nagpakita ug operasyon hangtod sa gabii, apan ang produce, retail ug food stalls dili pareho ug opening/closing time. Kung naa kay espesipikong tindahan nga tuyo, i-check kini sa adlaw sa imong pagbisita.</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section id="transport" class="section-pad market-grid border-b-2 border-[var(--ink)]">
        <div class="shell">
          <div class="grid gap-12 lg:grid-cols-[.75fr_1.25fr]">
            <div>
              <p class="kicker">Detalyadong transportasyon</p>
              <h2 class="display mt-5 text-5xl leading-[.92] sm:text-7xl">Pag-abot sa Carbon</h2>
              <p class="mt-6 max-w-md leading-7 text-[var(--muted)]">Ayaw i-memorize ang karaang jeepney route codes. Ang downtown traffic ug redevelopment mahimong makausab sa agianan; mas lig-on ang destination-based nga pagsakay.</p>
            </div>

            <div class="space-y-0">
              <article class="route-line grid grid-cols-[2rem_1fr] gap-5 pb-9">
                <div class="z-10 grid size-8 place-items-center rounded-full border-2 border-[var(--ink)] bg-[var(--market-orange)] text-xs font-black">A</div>
                <div>
                  <h3 class="text-xl font-black">Gikan Basilica / Magellan’s Cross</h3>
                  <p class="mt-2 leading-7 text-[var(--muted)]">Lakaw paingon sa Carbon district. Mao kini ang pinakasayon nga combination kung nag-heritage walk ka sa downtown.</p>
                </div>
              </article>
              <article class="route-line grid grid-cols-[2rem_1fr] gap-5 pb-9">
                <div class="z-10 grid size-8 place-items-center rounded-full border-2 border-[var(--ink)] bg-[var(--paper)] text-xs font-black">B</div>
                <div>
                  <h3 class="text-xl font-black">Gikan Pier 1</h3>
                  <p class="mt-2 leading-7 text-[var(--muted)]">Taxi/Grab ang pinakasayon kung naay bagahe. Kung gaan ang dala, mahimo nimo iusa ang Plaza Independencia ug Fort San Pedro sa imong ruta padulong sa Carbon.</p>
                </div>
              </article>
              <article class="route-line grid grid-cols-[2rem_1fr] gap-5 pb-9">
                <div class="z-10 grid size-8 place-items-center rounded-full border-2 border-[var(--ink)] bg-[var(--paper)] text-xs font-black">C</div>
                <div>
                  <h3 class="text-xl font-black">Gikan Fuente / Ayala / IT Park / SM City</h3>
                  <p class="mt-2 leading-7 text-[var(--muted)]">Taxi o Grab para diretso. Sa jeepney, pangitaa ang signboard nga “Carbon” ug kumpirmaha sa drayber o konduktor sa dili pa mosakay.</p>
                </div>
              </article>
              <article class="route-line grid grid-cols-[2rem_1fr] gap-5">
                <div class="z-10 grid size-8 place-items-center rounded-full border-2 border-[var(--ink)] bg-[var(--leaf)] text-xs font-black text-white">D</div>
                <div>
                  <h3 class="text-xl font-black">Gikan Mactan-Cebu International Airport</h3>
                  <p class="mt-2 leading-7 text-[var(--muted)]">Taxi o app-based ride ang pinakapraktikal nga door-to-door option, labi na kung first time nimo sa downtown. Ibutang “Carbon Market, M. C. Briones St” isip destination.</p>
                </div>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section id="food" class="section-pad overflow-hidden">
        <div class="shell">
          <div class="grid items-end gap-8 md:grid-cols-2">
            <div>
              <p class="kicker">Duol nga pagkaon</p>
              <h2 class="display mt-5 text-5xl leading-[.92] sm:text-7xl">Kaon nga walay arte</h2>
            </div>
            <p class="text-lg leading-8 text-[var(--muted)]">Ang pinakasakto nga food plan sa Carbon dili formal nga reservation. Lakaw, tan-aw unsay init ug daghan ang lokal nga mamalitay, ug pagpili gikan sa market stalls ug nearby food hub.</p>
          </div>

          <div class="mt-12 grid gap-5 lg:grid-cols-[1.15fr_.85fr]">
            <figure class="photo-frame relative min-h-[430px]">
              <img src="/images/carbon-market-night.jpg" alt="Carbon Market sa gabii nga adunay mga stall ug tawo" loading="lazy" width="1400" height="933" />
              <figcaption class="absolute bottom-4 left-4 max-w-xs bg-[var(--ink)] p-4 text-[var(--paper)]">
                <strong class="block uppercase tracking-wider text-[var(--market-orange)]">Market appetite</strong>
                <span class="mt-1 block text-sm leading-6 text-white/75">Ayaw pagdali; usa ka snack, usa ka loop, dayon balik sa stall nga pinakaganahan nimo.</span>
              </figcaption>
            </figure>

            <div class="grid gap-5">
              <article class="price-tag p-6">
                <span class="text-xs font-black uppercase tracking-[.18em] text-[var(--tomato)]">01 · Pusô Village</span>
                <h3 class="mt-3 text-2xl font-black">Food + retail hub sulod sa Carbon area</h3>
                <p class="mt-3 leading-7 text-[var(--muted)]">Maayong stop kung gusto nimo ug mas organisadong food choices ug lingkoranan samtang nagpabilin duol sa merkado.</p>
              </article>
              <article class="border-2 border-[var(--ink)] bg-[var(--leaf)] p-6 text-white">
                <span class="text-xs font-black uppercase tracking-[.18em] text-[var(--paper)]/70">02 · Carinderia & stalls</span>
                <h3 class="mt-3 text-2xl font-black">Puso, sud-an ug adlaw-adlaw nga pagkaon</h3>
                <p class="mt-3 leading-7 text-white/78">Pangitaa ang busy nga stall, tan-awa ang freshly cooked trays ug pangutana unsay bag-o nga luto.</p>
              </article>
              <article class="border-2 border-[var(--ink)] bg-[var(--market-orange)] p-6">
                <span class="text-xs font-black uppercase tracking-[.18em]">03 · Colon / downtown snacks</span>
                <h3 class="mt-3 text-2xl font-black">Padayon ang lakaw, padayon ang tilaw</h3>
                <p class="mt-3 leading-7 text-[var(--ink-soft)]">Kung gikan ka sa heritage loop, iapil ang bakery, ngohiong ug street-snack stops sa downtown imbes nga usa ra ka dako nga meal.</p>
              </article>
            </div>
          </div>
        </div>
      </section>

      <section id="nearby" class="puso-pattern border-y-2 border-[var(--ink)] text-[var(--paper)]">
        <div class="shell section-pad">
          <p class="kicker !text-[var(--market-orange)]">Duol nga mga lugar</p>
          <div class="mt-5 grid gap-8 lg:grid-cols-[.7fr_1.3fr]">
            <h2 class="display text-5xl leading-[.92] sm:text-7xl">Himoa kini nga Old Cebu loop</h2>
            <div class="grid gap-px border border-white/25 bg-white/25 sm:grid-cols-2">
              {nearby.map((item, index) => (
                <article class="bg-[var(--ink)] p-6 transition hover:bg-[var(--ink-soft)]">
                  <span class="display text-4xl text-[var(--market-orange)]">0{index + 1}</span>
                  <h3 class="mt-6 text-xl font-black">{item.name}</h3>
                  <p class="mt-3 leading-7 text-white/64">{item.note}</p>
                </article>
              ))}
            </div>
          </div>
          <div class="mt-8 border border-[var(--market-orange)] bg-[var(--market-orange)]/10 p-5 text-sm leading-6 text-white/75">
            <strong class="text-[var(--market-orange)]">Suggested flow:</strong> Carbon Market → Magellan’s Cross → Basilica del Santo Niño → Plaza Independencia → Fort San Pedro. Ang actual access mahimong mausab tungod sa roadworks ug redevelopment.
          </div>
        </div>
      </section>

      <section id="mapa" class="section-pad border-b-2 border-[var(--ink)]">
        <div class="shell">
          <div class="grid gap-8 lg:grid-cols-[.6fr_1.4fr]">
            <div>
              <p class="kicker">Mapa ug lokasyon</p>
              <h2 class="display mt-5 text-5xl leading-[.92] sm:text-7xl">59 M. C. Briones St</h2>
              <p class="mt-5 text-lg leading-8 text-[var(--muted)]">Cebu City, 6000 Cebu, Philippines</p>
              <div class="mt-7 price-tag p-5">
                <p class="text-xs font-black uppercase tracking-[.15em] text-[var(--tomato)]">Sa navigation app</p>
                <p class="mt-2 font-bold">I-search ang “Carbon Market” ug i-check nga ang pin naa sa M. C. Briones St / downtown Cebu.</p>
              </div>
            </div>
            <div class="overflow-hidden border-2 border-[var(--ink)] bg-[var(--ink)] shadow-[8px_8px_0_var(--market-orange)]">
              <iframe
                title="Mapa sa Carbon Market, Cebu City"
                src="https://www.google.com/maps?q=10.2914389%2C123.899131&hl=ceb&z=17&output=embed"
                width="100%"
                height="520"
                style="border:0"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
          </div>
        </div>
      </section>

      <section id="faq" class="section-pad market-grid">
        <div class="shell grid gap-10 lg:grid-cols-[.65fr_1.35fr]">
          <div>
            <p class="kicker">FAQ · Kanunay nga pangutana</p>
            <h2 class="display mt-5 text-5xl leading-[.92] sm:text-7xl">Antes ka molakaw</h2>
          </div>
          <div class="border-t-2 border-[var(--ink)]">
            {faqs.map((item) => (
              <details class="faq-item group border-b-2 border-[var(--ink)] py-1">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-lg font-black marker:hidden">
                  <span>{item.q}</span>
                  <span class="faq-plus grid size-8 shrink-0 place-items-center border-2 border-[var(--ink)] bg-[var(--market-orange)] text-2xl leading-none" aria-hidden="true">+</span>
                </summary>
                <p class="max-w-2xl pb-6 pr-10 leading-7 text-[var(--muted)]">{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="border-t-2 border-[var(--ink)] bg-[var(--paper-deep)]">
      <div class="shell grid gap-8 py-10 md:grid-cols-[1fr_auto] md:items-end">
        <div>
          <img src="/logo.svg" width="242" height="64" alt="Pamilihang Carbon" class="h-12 w-auto" />
          <p class="mt-5 max-w-xl text-sm leading-6 text-[var(--muted)]">Kini nga website usa ka independent, dili opisyal nga visitor guide ug walay opisyal nga koneksyon sa Cebu City Government, Carbon Market management, o mga negosyo nga gihisgutan.</p>
          <p class="mt-3 text-xs leading-5 text-[var(--muted)]">Mga hulagway: Megawide Construction Corporation, Chill and Travel, Suroy.ph, ug PH Radio Travel Book. Gitipigan lokal sa site build; tan-awa ang README para sa source credits.</p>
        </div>
        <div class="text-left md:text-right">
          <a href="#top" class="inline-flex border-2 border-[var(--ink)] px-4 py-3 text-xs font-black uppercase tracking-[.15em] transition hover:bg-[var(--market-orange)]">Balik sa ibabaw ↑</a>
          <p class="mt-4 text-xs font-bold uppercase tracking-[.12em] text-[var(--muted)]">Cebu City · Philippines</p>
        </div>
      </div>
    </footer>
  </body>
</html>
