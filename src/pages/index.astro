---
import '../styles/global.css';

const siteOrigin = Astro.site ?? new URL('https://cebucarbon.com');
const siteUrl = siteOrigin.origin;
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const socialImage = new URL('/images/carbon-market-hero.jpg', siteOrigin).href;
const socialImageAlt = 'Carbon Market - Main view in Cebu City, Philippines';

const mapsShareUrl = 'https://maps.app.goo.gl/F5UNUWTsDvdTbNph7';
const govTourismUrl = 'https://www.cebucity.gov.ph/';
const nationalTourismUrl = 'https://www.tourism.gov.ph/';

const rating = { value: '4.2', count: 7580, countLabel: '7,580', best: 5 };
const ratingSyncedAt = '2026 年 9 月';
const starWidth = `${(Number(rating.value) / rating.best) * 100}%`;

const pageTitle = 'Carbon Market (Cebu City) · Pamilihang Carbon - Visitor Guide & Location';
const pageDescription = 'Giya sa pagbisita sa Carbon Market (Pamilihang Carbon) sa Cebu City, Cebu, Philippines: lokasyon ug mapa, oras, libre nga pagsulod, duol nga Magellan’s Cross ug Basilica Minore del Santo Niño, transportasyon, parking ug praktikal nga tips.';
const ogTitle = 'Carbon Market (Pamilihang Carbon) - Cebu City Travel Guide';
const ogDescription = 'Independent visitor guide to Carbon Market (Pamilihang Carbon) in Cebu City, Cebu, Philippines — location map, opening details, food, transport and travel tips.';

const highlights = [
  { value: 'Libre', label: 'pagsulod sa merkado' },
  { value: '1–3 ka oras', label: 'maayong gidugayon sa suroy' },
  { value: 'Sayong buntag', label: 'para sa preskong abot' },
  { value: 'Downtown', label: 'duol sa karaang Sugbo' },
];

const nearby = [
  { name: 'Magellan’s Cross', note: 'Usa ka mubo nga lakaw paingon sa Plaza Sugbo; sayon iusa sa usa ka heritage walk.' },
  { name: 'Basilica Minore del Santo Niño', note: 'Ang pinakailadong religious landmark sa sentro sa Sugbo, tupad ra sa Magellan’s Cross.' },
  { name: 'Fort San Pedro', note: 'Padayon gikan sa Plaza Independencia para sa usa ka hapsay nga ruta gikan merkado ngadto sa baybayon.' },
  { name: 'Casa Gorordo Museum', note: 'Para sa mas lawom nga tan-aw sa kinabuhi ug arkitektura sa karaang Cebu.' },
];

const faqs = [
  {
    q: 'Asa nahimutang ang Carbon Market?',
    a: 'Ang Carbon Market (Pamilihang Carbon) nahimutang sa 59 M. C. Briones St, Cebu City, 6000 Cebu, Philippines. Ang plus code niini 7VRX+HM Cebu City, ug kini anaa sa downtown district duol sa Magellan’s Cross ug Basilica Minore del Santo Niño.'
  },
  {
    q: 'Unsa ang kasaysayan ug importansya sa Carbon Market?',
    a: 'Ang Carbon usa sa mga karaang public market sa Sugbo ug dugay nang sentro sa wholesale ug retail sa downtown. Ang ngalan niini kasagarang gipasabot nga naggikan sa daang depot sa uling (carbon). Karon padayon kini nga gi-redevelop, apan nagpabilin kini nga adlaw-adlaw nga merkado sa mga lumad nga Sugbuanon.'
  },
  {
    q: 'Naay entrance fee sa Carbon Market?',
    a: 'Wala. Libre ang pagsulod sa merkado. Bayran ra nimo ang imong paliton, pagkaon, transportasyon ug ubang personal nga gasto.'
  },
  {
    q: 'Unsa ang pinakamaayong oras sa pag-adto?',
    a: 'Sayong buntag ang nindot para sa preskong abot ug mas bugnaw nga lakaw. Kung gusto ka sa mas buhing food-and-city atmosphere, maayo usab ang ulahing hapon. Magkalahi ang oras sa tagsa-tagsa ka tindahan.'
  },
  {
    q: 'Pila ka oras ang angay igahin?',
    a: 'Kasagaran igo ang 1–3 ka oras para sa merkado, pagkaon ug litrato. Dugangi ang oras kung iapil nimo ang Basilica, Magellan’s Cross ug Fort San Pedro.'
  },
  {
    q: 'Unsaon pag-adto kung gikan sa sentro sa Cebu?',
    a: 'Taxi o Grab ang pinakasayon. Sa jeepney, pangitaa ang signboard nga paingon sa Carbon ug pangutan-a ang drayber kay mahimong mausab ang ruta tungod sa traffic ug redevelopment.'
  },
  {
    q: 'Naay parking?',
    a: 'Adunay parking options sulod sa redeveloped Carbon area ug duol sa Pusô Village. Ang access ug capacity mahimong mausab, busa sundi ang on-site signs ug marshals sa adlaw sa imong pagbisita.'
  },
  {
    q: 'Okay ba dal-on ang bata o senior?',
    a: 'Pwede, apan hinumdomi nga aktibong merkado kini: mahimong huot, basa ang pipila ka agianan ug daghan ang delivery traffic. Mas komportable ang closed shoes ug mas hinay nga pacing.'
  },
];

const attractionSchema = {
  '@context': 'https://schema.org',
  '@type': ['TouristAttraction', 'LocalBusiness'],
  '@id': `${siteUrl}/#attraction`,
  name: 'Carbon Market',
  alternateName: ['Pamilihang Carbon', 'Cebu City Carbon Market'],
  description:
    'Comprehensive visitor guide to Carbon Market (Pamilihang Carbon) in Cebu City, Cebu, Philippines.',
  url: canonical,
  image: [
    `${siteUrl}/images/carbon-market-hero.jpg`,
    `${siteUrl}/images/carbon-market-aerial.jpg`,
    `${siteUrl}/images/carbon-market-night.jpg`,
    `${siteUrl}/images/carbon-market-produce-night.jpg`,
  ],
  hasMap: mapsShareUrl,
  sameAs: [mapsShareUrl, govTourismUrl],
  address: {
    '@type': 'PostalAddress',
    streetAddress: '59 M. C. Briones St',
    addressLocality: 'Cebu City',
    postalCode: '6000',
    addressRegion: 'Cebu',
    addressCountry: 'PH',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 10.2914389,
    longitude: 123.899131,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '00:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '00:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '00:00', closes: '19:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Thursday', opens: '05:00', closes: '18:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '00:30', closes: '10:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '00:00', closes: '15:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '00:00', closes: '19:00' },
  ],
  isAccessibleForFree: true,
  priceRange: 'Libre ang pagsulod',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};
---

<!doctype html>
<html lang="ceb">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#15271f" />
    <meta name="color-scheme" content="light" />
    <meta name="geo.region" content="PH-CEB" />
    <meta name="geo.placename" content="Cebu City, Cebu, Philippines" />
    <meta name="ICBM" content="10.2914389, 123.899131" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ceb" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="fil" href={`${siteUrl}/fil/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pamilihang Carbon" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:locale" content="ceb_PH" />
    <meta property="og:locale:alternate" content="fil_PH" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="icon" href="/icons/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icons/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icons/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Pamilihang Carbon" />
    <meta name="mobile-web-app-capable" content="yes" />
    <script type="application/ld+json" set:html={JSON.stringify(attractionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
    <script is:inline>
      if ('serviceWorker' in navigator && location.protocol === 'https:') {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[200] focus:bg-[var(--market-orange)] focus:px-4 focus:py-3 focus:font-bold">Laktawi ngadto sa sulod</a>

    <header class="sticky top-0 z-50 border-b-2 border-[var(--ink)] bg-[color:rgba(243,234,213,.94)] backdrop-blur-md">
      <div class="shell flex min-h-18 items-center justify-between gap-6 py-3">
        <a href="#top" aria-label="Pamilihang Carbon — balik sa ibabaw" class="shrink-0">
          <img src="/logo.svg" width="242" height="64" alt="Pamilihang Carbon" class="h-12 w-auto sm:h-13" />
        </a>
        <nav aria-label="Pangunang nabigasyon" class="hidden items-center gap-5 text-[13px] font-extrabold uppercase tracking-[.13em] lg:flex">
          <a class="nav-link" href="#about">Mahitungod</a>
          <a class="nav-link" href="#plan">Pagplano</a>
          <a class="nav-link" href="#food">Pagkaon</a>
          <a class="nav-link" href="#nearby">Duol</a>
          <a class="nav-link" href="#reviews">Rebyu</a>
          <a class="nav-link" href="#faq">FAQ</a>
        </nav>
        <div class="flex items-center gap-2">
          <div role="group" aria-label="Pagpili sa sinultian" class="flex items-center border-2 border-[var(--ink)] text-[11px] font-black uppercase tracking-[.14em]">
            <a href="/" class="px-3 py-2.5 bg-[var(--market-orange)] text-[var(--ink)] border-r-2 border-[var(--ink)]" aria-current="true">Cebuano</a>
            <a href="/fil/" class="px-3 py-2.5 bg-[var(--paper)] text-[var(--ink)] hover:bg-white/50 transition">Filipino</a>
          </div>
          <a href="#mapa" class="border-2 border-[var(--ink)] bg-[var(--ink)] px-4 py-2.5 text-xs font-black uppercase tracking-[.14em] text-[var(--paper)] shadow-[4px_4px_0_var(--market-orange)] transition hover:-translate-y-0.5">Mapa</a>
        </div>
      </div>
    </header>

    <main id="main">
      <section id="top" class="market-grid relative overflow-hidden border-b-2 border-[var(--ink)]">
        <div class="shell grid min-h-[calc(100vh-76px)] items-stretch lg:grid-cols-[.92fr_1.08fr]">
          <div class="relative z-10 flex flex-col justify-center py-14 lg:pr-12 lg:py-20">
            <p class="kicker">Cebu City · Sugbo · Philippines</p>
            <h1 class="display mt-6 max-w-[11ch] text-[clamp(3.4rem,8vw,7.2rem)] leading-[.8]">Carbon Market <span class="block text-[var(--market-orange)]">(Cebu City)</span></h1>
            <p class="mt-4 text-sm font-black uppercase tracking-[.16em] text-[var(--muted)]">Pamilihang Carbon · 59 M. C. Briones St, Cebu City, 6000 Cebu, Philippines</p>
            <div class="mt-7 max-w-xl border-l-[5px] border-[var(--market-orange)] pl-5 text-lg leading-8 text-[var(--ink-soft)] sm:text-xl">
              Dili kini lugar nga tan-awon lang. Kini usa ka <strong>buhing merkado</strong> — preskong abot, tingog sa tindero, puso ug sud-an, ug adlaw-adlaw nga kinabuhi sa karaang Sugbo.
            </div>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#plan" class="inline-flex items-center gap-3 border-2 border-[var(--ink)] bg-[var(--market-orange)] px-5 py-3.5 text-sm font-black uppercase tracking-[.12em] shadow-[5px_5px_0_var(--ink)] transition hover:-translate-y-1">Planoha ang suroy <span aria-hidden="true">↘</span></a>
              <a href="#experience" class="inline-flex items-center gap-3 border-2 border-[var(--ink)] bg-[var(--paper)] px-5 py-3.5 text-sm font-black uppercase tracking-[.12em] transition hover:bg-white/50">Ilhon ang merkado</a>
            </div>
            <p class="mt-8 max-w-lg text-sm leading-6 text-[var(--muted)]">Padayon ang redevelopment sa Carbon; mahimong mausab ang pipila ka entrada, pwesto ug traffic flow. Sundon ang on-site signage sa adlaw sa pagbisita.</p>
          </div>

          <div class="relative min-h-[550px] border-t-2 border-[var(--ink)] lg:border-l-2 lg:border-t-0">
            <img src="/images/carbon-market-hero.jpg" alt="Carbon Market - Main view in Cebu City, Philippines" width="1400" height="934" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-[rgba(21,39,31,.72)] via-transparent to-[rgba(21,39,31,.15)]"></div>
            <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between gap-4">
              <div class="max-w-sm bg-[var(--paper)] p-4 shadow-[5px_5px_0_var(--market-orange)]">
                <p class="text-xs font-black uppercase tracking-[.16em] text-[var(--tomato)]">Kasingkasing sa downtown</p>
                <p class="mt-1 font-bold leading-6">Merkado, pagkaon ug heritage landmarks sa usa ra ka lakaw.</p>
              </div>
              <div class="hidden size-20 rotate-6 items-center justify-center border-2 border-[var(--paper)] bg-[var(--ink)] text-center text-[10px] font-black uppercase tracking-[.1em] text-[var(--paper)] sm:flex">Suroy<br/>Sugbo</div>
            </div>
          </div>
        </div>

        <div class="border-t-2 border-[var(--ink)] bg-[var(--ink)] text-[var(--paper)]">
          <div class="shell grid grid-cols-2 lg:grid-cols-4">
            {highlights.map((item, index) => (
              <div class:list={["px-4 py-5 sm:px-6", index > 0 && "border-l border-white/20", index === 2 && "border-l-0 lg:border-l", index >= 2 && "border-t border-white/20 lg:border-t-0"]}>
                <div class="display text-2xl text-[var(--market-orange)] sm:text-3xl">{item.value}</div>
                <div class="mt-1 text-xs font-semibold uppercase tracking-[.1em] text-white/68">{item.label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section id="about" class="section-pad border-b-2 border-[var(--ink)] bg-[var(--paper-deep)]">
        <div class="shell grid gap-10 lg:grid-cols-[.75fr_1.25fr]">
          <div>
            <p class="kicker">Mahitungod sa Carbon</p>
            <h2 class="display mt-5 text-5xl leading-[.92] sm:text-6xl">About Carbon Market</h2>
            <p class="mt-4 text-lg font-black uppercase tracking-[.1em] text-[var(--tomato)]">Pamilihang Carbon · Cebu City</p>
            <nav aria-label="Breadcrumb" class="mt-6 text-xs font-bold uppercase tracking-[.14em] text-[var(--muted)]">
              <ol class="flex flex-wrap items-center gap-2">
                <li>Carbon Market</li><li aria-hidden="true">→</li>
                <li>Cebu City</li><li aria-hidden="true">→</li>
                <li>Cebu</li><li aria-hidden="true">→</li>
                <li>Philippines</li>
              </ol>
            </nav>
          </div>
          <div>
            <p class="text-lg leading-8 text-[var(--ink-soft)]">
              Welcome to <strong>Carbon Market</strong>, widely recognized as the central <strong>Pamilihang Carbon</strong>. Located in the heart of <strong>Cebu City</strong>, <strong>Cebu</strong>, <strong>Philippines</strong>, this destination serves as a primary hub for travelers visiting the region.
            </p>
            <p class="mt-5 leading-8 text-[var(--muted)]">
              Sa Cebuano, “Pamilihang Carbon” ug “Carbon Market” pareho ra nga gitumong: ang nag-unang public market sa downtown Sugbo. Diri nagtagbo ang wholesale nga abot, adlaw-adlaw nga palit sa mga lumad, pagkaon sa karsada ug heritage landmarks — mao nga kini ang natural nga sugdanan sa usa ka Old Cebu walking loop.
            </p>
            <dl class="mt-8 grid gap-px border-2 border-[var(--ink)] bg-[var(--ink)] sm:grid-cols-2">
              <div class="bg-[var(--paper)] p-5">
                <dt class="text-xs font-black uppercase tracking-[.16em] text-[var(--tomato)]">Opisyal nga ngalan</dt>
                <dd class="mt-2 font-bold">Carbon Market · Pamilihang Carbon</dd>
              </div>
              <div class="bg-[var(--paper)] p-5">
                <dt class="text-xs font-black uppercase tracking-[.16em] text-[var(--tomato)]">Kategoriya</dt>
                <dd class="mt-2 font-bold">Market · Public market</dd>
              </div>
              <div class="bg-[var(--paper)] p-5">
                <dt class="text-xs font-black uppercase tracking-[.16em] text-[var(--tomato)]">Address</dt>
                <dd class="mt-2 font-bold">59 M. C. Briones St, Cebu City, 6000 Cebu, Philippines</dd>
              </div>
              <div class="bg-[var(--paper)] p-5">
                <dt class="text-xs font-black uppercase tracking-[.16em] text-[var(--tomato)]">Plus code</dt>
                <dd class="mt-2 font-bold">7VRX+HM Cebu City, Cebu, Philippines</dd>
              </div>
            </dl>
          </div>
        </div>
      </section>

      <section id="experience" class="section-pad overflow-hidden">
        <div class="shell">
          <div class="grid items-end gap-8 lg:grid-cols-[.8fr_1.2fr]">
            <div>
              <p class="kicker">Kasinaran sa Carbon</p>
              <h2 class="display mt-5 text-5xl leading-[.92] sm:text-7xl">About Carbon Market</h2>
              <h3 class="mt-4 text-2xl font-black uppercase tracking-wide text-[var(--tomato)]">Merkado una. Tourist spot ikaduha.</h3>
            </div>
            <p class="max-w-2xl text-lg leading-8 text-[var(--muted)] lg:justify-self-end">Ang Carbon mao ang usa sa labing iladong public markets sa Cebu. Ang kalami niini naa sa tinuod nga lihok sa lungsod: prutas ug utan, isda, karne, dry goods, handicrafts ug pagkaon — dili curated display, kundili adlaw-adlaw nga palit ug baligya.</p>
          </div>

          <div class="mt-14 grid auto-rows-[220px] gap-5 md:grid-cols-12 md:auto-rows-[240px]">
            <figure class="photo-frame relative md:col-span-7 md:row-span-2">
              <img src="/images/carbon-market-aerial.jpg" alt="Talan-awon sa Carbon Market area sa gabii gikan sa taas" loading="lazy" width="1024" height="767" />
              <figcaption class="absolute bottom-3 left-3 bg-[var(--paper)] px-3 py-2 text-xs font-black uppercase tracking-[.12em]">Buhing downtown</figcaption>
            </figure>
            <div class="price-tag flex flex-col justify-between p-6 md:col-span-5">
              <span class="display text-5xl text-[var(--market-orange)]">01</span>
              <div>
                <h3 class="text-xl font-black uppercase tracking-wide">Preskong abot</h3>
                <p class="mt-2 leading-6 text-[var(--muted)]">Sayong buntag, mas klaro ang rhythm sa produce, seafood ug wholesale movement.</p>
              </div>
            </div>
            <figure class="photo-frame relative md:col-span-5">
              <img src="/images/carbon-market-produce-night.jpg" alt="Mga tindahan sa Carbon Market nga adunay prutas, utan ug gabii nga suga" loading="lazy" width="1200" height="800" />
              <figcaption class="absolute bottom-3 left-3 bg-[var(--market-orange)] px-3 py-2 text-xs font-black uppercase tracking-[.12em]">Kolor sa merkado</figcaption>
            </figure>
          </div>

          <div class="mt-5 grid gap-5 md:grid-cols-3">
            <article class="border-2 border-[var(--ink)] p-6">
              <span class="text-3xl" aria-hidden="true">◈</span>
              <h3 class="mt-5 text-xl font-black uppercase">Palit sama sa lokal</h3>
              <p class="mt-3 leading-7 text-[var(--muted)]">Pagdala ug gamay nga cash ug reusable bag. Pangutana sa presyo una ug ayaw kahadlok motan-aw sa lain-laing stall.</p>
            </article>
            <article class="border-2 border-[var(--ink)] bg-[var(--leaf)] p-6 text-white">
              <span class="text-3xl" aria-hidden="true">◇</span>
              <h3 class="mt-5 text-xl font-black uppercase">Sul-ob ug closed shoes</h3>
              <p class="mt-3 leading-7 text-white/80">Aktibong public market kini. Ang pipila ka agianan mahimong basa o puno sa delivery carts, labi na sa busy nga oras.</p>
            </article>
            <article class="border-2 border-[var(--ink)] bg-[var(--market-orange)] p-6">
              <span class="text-3xl" aria-hidden="true">✦</span>
              <h3 class="mt-5 text-xl font-black uppercase">Ipares sa heritage walk</h3>
              <p class="mt-3 leading-7 text-[var(--ink-soft)]">Human sa merkado, dali ra ipadayon paingon sa Magellan’s Cross, Basilica ug Fort San Pedro.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="plan" class="border-y-2 border-[var(--ink)] bg-[var(--ink)] text-[var(--paper)]">
        <div class="shell section-pad">
          <div class="grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
            <div class="lg:sticky lg:top-28 lg:self-start">
              <p class="kicker !text-[var(--market-orange)]">Praktikal nga giya</p>
              <h2 class="display mt-5 text-4xl leading-[.95] sm:text-5xl">Location &amp; How to Visit Carbon Market in Cebu City</h2>
              <h3 class="mt-4 text-xl font-black uppercase tracking-wide text-[var(--market-orange)]">Sa dili pa ka mosulod</h3>
              <p class="mt-6 max-w-md leading-7 text-white/65">Ang Carbon usa ka working market. Ang pinakamaayong plano flexible: pilia ang oras, kahibalo sa imong transport, ug ibilin ang sobra nga schedule.</p>
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <article class="border border-white/25 bg-white/[.05] p-6 sm:col-span-2">
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <p class="text-xs font-black uppercase tracking-[.18em] text-[var(--market-orange)]">Gasto / Bayranan</p>
                    <h3 class="display mt-2 text-4xl">Walay entrance fee</h3>
                  </div>
                  <span class="display text-5xl text-white/20">₱0</span>
                </div>
