          <div>
            <p class="kicker">FAQ · Madalas itanong</p>
            <h2 class="display mt-5 text-4xl leading-[.95] sm:text-5xl">Carbon Market FAQ · Cebu City</h2>
            <h3 class="mt-4 text-xl font-black uppercase tracking-wide text-[var(--tomato)]">Bago ka umalis</h3>
          </div>
          <div class="border-t-2 border-[var(--ink)]">
            {faqs.map((item) => (
              <details class="faq-item group border-b-2 border-[var(--ink)] py-1">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left text-lg font-black marker:hidden">
                  <span>{item.q}</span>
                  <span class="faq-plus grid size-8 shrink-0 place-items-center border-2 border-[var(--ink)] bg-[var(--market-orange)] text-2xl leading-none" aria-hidden="true">+</span>
